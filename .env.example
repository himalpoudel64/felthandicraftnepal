# Copy this file to .env and fill in the values.
# In Cloudflare Pages, add the same names under Settings > Variables and Secrets.

# Sanity project ID, from sanity.io/manage. Leave empty to build from studio/seed/seed.ndjson.
PUBLIC_SANITY_PROJECT_ID=

# Sanity dataset name.
PUBLIC_SANITY_DATASET=production

# Public address of the site: https, no trailing slash.
SITE_URL=https://felthandicraftnepal.com

# Web3Forms access key, created for felthandicraftnepal@gmail.com.
# Web3Forms designs this key to appear in page HTML. It only sends mail to that inbox.
PUBLIC_WEB3FORMS_KEY=
