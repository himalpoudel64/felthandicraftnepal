# Copy to .env.local for local development. Set the same values in Cloudflare Pages for production.

# Sanity project ID (sanity.io/manage). If blank, the site builds from studio/seed/seed.ndjson.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Canonical origin: https, no trailing slash. Use https://www.… only if the client prefers www.
SITE_URL=https://felthandicraftnepal.com

# Access key from web3forms.com. It is designed to be public and ends up in the page HTML.
WEB3FORMS_KEY=
