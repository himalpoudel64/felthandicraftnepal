---
import { getContent } from "../lib/sanity";

interface Props {
  email: string;
  businessName: string;
  whatsappUrl: string;
  /** Present in the product dialog. The size is filled in when the dialog opens. */
  product?: { name: string; category: string; url: string; hasSizes: boolean };
  idPrefix: string;
}

const { email, businessName, whatsappUrl, product, idPrefix } = Astro.props;
const key = import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined;
const id = (name: string) => `${idPrefix}-${name}`;
const labelClass = "mb-1 block text-sm font-medium";
const errorClass = "mt-1 text-sm text-terracotta-ink";
const privacy = (await getContent()).legal.find((page) => page._id === "privacyPolicy");
---

<form
  data-enquiry-form
  data-key={key ?? ""}
  data-email={email}
  data-business={businessName}
  data-product={product?.name}
  data-category={product?.category}
  data-url={product?.url}
  novalidate
  class="grid grid-cols-2 gap-x-4 gap-y-4"
>
  <div class="col-span-2">
    <label for={id("name")} class={labelClass}>Full Name <span aria-hidden="true">*</span></label>
    <input id={id("name")} name="name" autocomplete="name" required class="field" aria-describedby={id("name-error")} />
    <p id={id("name-error")} data-error="name" class={errorClass} hidden></p>
  </div>
  <div class="col-span-2 sm:col-span-1">
    <label for={id("email")} class={labelClass}>Email Address <span aria-hidden="true">*</span></label>
    <input id={id("email")} name="email" type="email" autocomplete="email" required class="field" aria-describedby={id("email-error")} />
    <p id={id("email-error")} data-error="email" class={errorClass} hidden></p>
  </div>
  <div class="col-span-2 sm:col-span-1">
    <label for={id("phone")} class={labelClass}>Phone Number <span class="font-normal text-ink-soft">(optional)</span></label>
    <input id={id("phone")} name="phone" type="tel" autocomplete="tel" class="field" />
  </div>

  {
    product && (
      <>
        <div class:list={["col-span-2", product.hasSizes && "sm:col-span-1"]}>
          <label for={id("product")} class={labelClass}>Product Name</label>
          <input id={id("product")} name="product" readonly value={product.name} class="field" />
        </div>
        {product.hasSizes && (
          <div class="col-span-2 sm:col-span-1">
            <label for={id("size")} class={labelClass}>Selected Size</label>
            <input id={id("size")} name="size" readonly class="field" data-field-size />
          </div>
        )}
      </>
    )
  }

  <div class="col-span-2">
    <label for={id("message")} class={labelClass}>Message <span class="font-normal text-ink-soft">(optional)</span></label>
    <textarea id={id("message")} name="message" rows="3" class="field" placeholder={product ? "Quantity, colours or any questions" : undefined}></textarea>
  </div>

  <!-- Honeypot: hidden from people, tempting to bots. -->
  <input type="checkbox" name="botcheck" tabindex="-1" aria-hidden="true" class="hidden" />

  <div class="col-span-2">
    <p class="mb-1 text-sm font-medium" id={id("captcha-label")}>Spam check</p>
    <div data-captcha class="min-h-[78px]" aria-labelledby={id("captcha-label")}>
      <p data-captcha-note class="text-sm text-ink-soft">A short check appears when you start filling in the form.</p>
    </div>
    <p data-error="captcha" class={errorClass} hidden></p>
  </div>

  <div class="col-span-2">
    <button type="submit" class="btn btn-primary w-full disabled:opacity-70 sm:w-auto">Send Enquiry</button>
    {
      privacy && (
        <p class="mt-3 text-sm text-ink-soft">
          We use your details only to reply to you. See our <a href={privacy.path} class="link-rule">{privacy.title}</a>.
        </p>
      )
    }
  </div>

  <div role="status" data-status class="col-span-2 empty:hidden"></div>

  <template data-success>
    <p class="border-l-2 border-forest pl-3 text-forest">Thank you. Your enquiry has been sent and we will reply soon.</p>
  </template>
  <template data-failure>
    <p class="border-l-2 border-terracotta pl-3">
      Sorry, your enquiry could not be sent from here.
      <a data-mailto href={`mailto:${email}`} class="link-rule font-medium">Email it to {email} instead</a>, or
      <a href={whatsappUrl} target="_blank" rel="noopener" data-fallback-whatsapp class="link-rule font-medium">message us on WhatsApp</a>.
    </p>
  </template>
</form>

<script>
  const ENDPOINT = "https://api.web3forms.com/submit";
  // Web3Forms' public hCaptcha site key for its free plan. Web3Forms checks the answer on its server.
  const HCAPTCHA_SITEKEY = "50b2fe65-b00b-4b9e-ad62-3ba471098be2";
  const HCAPTCHA_SCRIPT = "https://js.hcaptcha.com/1/api.js?render=explicit&onload=__onHcaptchaLoad";

  type HCaptcha = {
    render: (container: HTMLElement, options: { sitekey: string }) => string;
    getResponse: (widgetId: string) => string;
    reset: (widgetId: string) => void;
  };
  type CaptchaWindow = Window & { hcaptcha?: HCaptcha; __onHcaptchaLoad?: () => void };

  let loading: Promise<HCaptcha> | undefined;

  /** Loads hCaptcha once, and only after someone starts using a form. */
  function loadCaptcha(): Promise<HCaptcha> {
    loading ??= new Promise<HCaptcha>((resolve, reject) => {
      const win = window as CaptchaWindow;
      win.__onHcaptchaLoad = () => (win.hcaptcha ? resolve(win.hcaptcha) : reject(new Error("hCaptcha missing")));
      const script = document.createElement("script");
      script.src = HCAPTCHA_SCRIPT;
      script.async = true;
      script.onerror = () => {
        loading = undefined;
        reject(new Error("hCaptcha failed to load"));
      };
      document.head.append(script);
    });
    return loading;
  }

  document.querySelectorAll<HTMLFormElement>("[data-enquiry-form]").forEach((form) => {
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = form.querySelector<HTMLElement>("[data-status]");
    const captchaBox = form.querySelector<HTMLElement>("[data-captcha]");
    const submitLabel = submit?.textContent ?? "";
    let sending = false;
    let widget: Promise<{ api: HCaptcha; id: string }> | undefined;

    const value = (name: string) => String(new FormData(form).get(name) ?? "").trim();

    function setError(name: string, message: string) {
      const input = form.elements.namedItem(name) as HTMLInputElement | null;
      const error = form.querySelector<HTMLElement>(`[data-error="${name}"]`);
      if (input) {
        if (message) input.setAttribute("aria-invalid", "true");
        else input.removeAttribute("aria-invalid");
      }
      if (error) {
        error.textContent = message;
        error.hidden = !message;
      }
    }

    function render(template: "success" | "failure"): void {
      const node = form.querySelector<HTMLTemplateElement>(`template[data-${template}]`);
      if (status && node) status.replaceChildren(node.content.cloneNode(true));
      // In the product dialog, the WhatsApp fallback keeps the chosen product and size.
      const productLink = form.closest("dialog")?.querySelector("[data-whatsapp]")?.getAttribute("href");
      if (productLink) form.querySelector("[data-fallback-whatsapp]")?.setAttribute("href", productLink);
    }

    function startCaptcha() {
      if (!captchaBox) return;
      widget ??= loadCaptcha().then((api) => {
        captchaBox.replaceChildren();
        return { api, id: api.render(captchaBox, { sitekey: HCAPTCHA_SITEKEY }) };
      });
      widget.catch(() => {
        widget = undefined;
        setError("captcha", "The spam check could not load. Please use the email or WhatsApp links below.");
        render("failure");
      });
    }

    form.addEventListener("focusin", startCaptcha);
    form.addEventListener("pointerdown", startCaptcha);

    function validate(): boolean {
      const name = value("name") ? "" : "Please enter your full name.";
      const email = !value("email")
        ? "Please enter your email address."
        : /^\S+@\S+\.\S+$/.test(value("email"))
          ? ""
          : "Please check this email address.";
      setError("name", name);
      setError("email", email);
      const first = name ? "name" : email ? "email" : "";
      if (first) (form.elements.namedItem(first) as HTMLElement).focus();
      return !first;
    }

    function mailtoLink(subject: string, details: Record<string, string>): string {
      const body = Object.entries(details).map(([label, text]) => `${label}: ${text}`).join("\n");
      const { email: recipient = "" } = form.dataset;
      return `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (sending || !validate()) return;
      status?.replaceChildren();
      // A filled honeypot gets a quiet success, so bots learn nothing.
      if (value("botcheck")) {
        render("success");
        return;
      }

      // Set before any await, so a second click cannot start a second submission.
      sending = true;
      startCaptcha();
      const captcha = await widget?.catch(() => undefined);
      const token = captcha ? captcha.api.getResponse(captcha.id) : "";
      if (!captcha || !token) {
        sending = false;
        if (captcha) {
          setError("captcha", "Please complete the spam check.");
          captchaBox?.querySelector("iframe")?.focus();
        }
        return;
      }
      setError("captcha", "");

      const { key = "", business = "", product, category, url } = form.dataset;
      const subject = product ? `Product Enquiry – ${product}` : `Website Enquiry – ${value("name")}`;
      const details: Record<string, string> = {
        name: value("name"),
        email: value("email"),
        phone: value("phone") || "Not given",
        ...(product
          ? { product, category: category ?? "", ...(value("size") ? { size: value("size") } : {}), "product link": url ?? "" }
          : {}),
        message: value("message") || "No message",
      };

      if (submit) {
        submit.disabled = true;
        submit.textContent = "Sending…";
      }

      try {
        if (!key) throw new Error("Form key not configured");
        const body = new FormData();
        Object.entries({ access_key: key, subject, from_name: business, ...details, "h-captcha-response": token }).forEach(
          ([name, text]) => body.append(name, text),
        );
        const response = await fetch(ENDPOINT, { method: "POST", headers: { Accept: "application/json" }, body });
        const result = (await response.json()) as { success?: boolean };
        if (!response.ok || !result.success) throw new Error("Submission rejected");
        render("success");
        form.reset();
        form.dispatchEvent(new CustomEvent("enquiry:sent"));
      } catch {
        render("failure");
        form.querySelector("[data-mailto]")?.setAttribute("href", mailtoLink(subject, details));
      } finally {
        captcha.api.reset(captcha.id);
        sending = false;
        if (submit) {
          submit.disabled = false;
          submit.textContent = submitLabel;
        }
      }
    });
  });
</script>
