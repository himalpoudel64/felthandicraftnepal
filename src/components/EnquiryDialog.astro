---
import { absoluteUrl, productPath } from "../lib/paths";
import type { Product, Settings } from "../lib/types";
import { GENERAL_MESSAGE, whatsappUrl } from "../lib/whatsapp";
import EmailEnquiryForm from "./EmailEnquiryForm.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";

interface Props {
  product: Product;
  settings: Settings;
}
const { product, settings } = Astro.props;
const url = absoluteUrl(productPath(product));
const optionClass = "flex min-h-24 w-full items-center gap-4 border border-ink p-4 text-left transition-colors hover:bg-ink hover:text-ivory";
---

<dialog
  data-enquiry
  data-number={settings.whatsappNumber}
  data-business={settings.businessName}
  data-product={product.name}
  data-category={product.category.title}
  data-url={url}
  aria-labelledby="enquiry-title"
  class="m-auto max-h-[92dvh] w-[min(36rem,calc(100vw-1.5rem))] max-w-none overflow-y-auto bg-paper p-0 text-ink"
>
  <div class="p-6 sm:p-8">
    <div class="sticky -top-6 z-10 -mt-1 flex items-start justify-between gap-4 bg-paper py-1 sm:-top-8">
      <h2 id="enquiry-title" tabindex="-1" class="text-sub outline-none">Enquire about this product</h2>
      <button type="button" data-close class="-mr-2 -mt-1 flex h-11 w-11 shrink-0 items-center justify-center" aria-label="Close enquiry">
        <svg aria-hidden="true" viewBox="0 0 14 14" class="h-3.5 w-3.5 fill-none stroke-current stroke-[1.5]"><path d="m1 1 12 12M13 1 1 13"></path></svg>
      </button>
    </div>
    <p class="mt-2 border-y border-rule py-3 text-[0.9375rem]">
      <span class="font-medium">{product.name}</span><br />
      Size: <span data-summary-size></span> · <span data-summary-price></span>
    </p>

    <div data-view="choice" class="mt-5 space-y-3">
      <a data-whatsapp href={whatsappUrl(settings.whatsappNumber, GENERAL_MESSAGE)} target="_blank" rel="noopener" class={optionClass}>
        <WhatsAppIcon class="h-8 w-8 shrink-0 text-whatsapp" />
        <span>
          <span class="block font-medium">Enquire via WhatsApp</span>
          <span class="block text-[0.9375rem]">Opens a chat with this product already written in.</span>
        </span>
      </a>
      <button type="button" data-show-email class={optionClass}>
        <svg aria-hidden="true" viewBox="0 0 24 18" class="h-8 w-8 shrink-0 fill-none stroke-current stroke-[1.5]"><path d="M1 1h22v16H1zM1 2l11 8 11-8"></path></svg>
        <span>
          <span class="block font-medium">Enquire via Email</span>
          <span class="block text-[0.9375rem]">Fill in a short form and we will reply by email.</span>
        </span>
      </button>
    </div>

    <div data-view="email" hidden class="mt-4">
      <button type="button" data-back class="link-rule mb-4 inline-flex min-h-11 items-center text-[0.9375rem]">Back to enquiry options</button>
      <EmailEnquiryForm
        idPrefix="dialog"
        email={settings.email}
        businessName={settings.businessName}
        whatsappUrl={whatsappUrl(settings.whatsappNumber, GENERAL_MESSAGE)}
        product={{ name: product.name, category: product.category.title, url }}
      />
    </div>
  </div>
</dialog>

<script>
  import { productMessage, whatsappUrl } from "../lib/whatsapp";

  const dialog = document.querySelector<HTMLDialogElement>("dialog[data-enquiry]");
  const sizes = document.querySelector<HTMLElement>("[data-sizes]");

  if (dialog && sizes) {
    const $ = <T extends HTMLElement>(selector: string) => dialog.querySelector<T>(selector);
    const choice = $("[data-view=choice]");
    const email = $("[data-view=email]");
    const priceOutput = document.querySelector<HTMLElement>("[data-price-output]");
    const sizeOutput = document.querySelector<HTMLElement>("[data-size-output]");

    const selected = () => {
      const input = sizes.querySelector<HTMLInputElement>("input:checked");
      return { size: input?.value ?? "", price: input?.dataset.display ?? "" };
    };

    /** Keeps the visible price, the summary, the form and the WhatsApp link in step. */
    function sync() {
      const { size, price } = selected();
      if (priceOutput) priceOutput.textContent = price;
      if (sizeOutput) sizeOutput.textContent = size;
      const summarySize = $("[data-summary-size]");
      const summaryPrice = $("[data-summary-price]");
      if (summarySize) summarySize.textContent = size;
      if (summaryPrice) summaryPrice.textContent = price;
      $<HTMLInputElement>("[data-field-size]")?.setAttribute("value", size);
      $<HTMLInputElement>("[data-field-price]")?.setAttribute("value", price);
      const { number = "", business = "", product = "", category = "", url = "" } = dialog!.dataset;
      const href = whatsappUrl(number, productMessage({ businessName: business, product, category, size, price, url }));
      $("[data-whatsapp]")?.setAttribute("href", href);
    }

    function showView(view: "choice" | "email") {
      if (choice) choice.hidden = view !== "choice";
      if (email) email.hidden = view !== "email";
      if (view === "email") $<HTMLInputElement>('input[name="name"]')?.focus();
      else $("[data-show-email]")?.focus();
    }

    sizes.addEventListener("change", sync);
    document.querySelector("[data-open-enquiry]")?.addEventListener("click", () => {
      sync();
      if (choice) choice.hidden = false;
      if (email) email.hidden = true;
      $("[data-status]")?.replaceChildren();
      dialog.showModal();
      $("#enquiry-title")?.focus();
    });
    $("[data-close]")?.addEventListener("click", () => dialog.close());
    $("[data-show-email]")?.addEventListener("click", () => showView("email"));
    $("[data-back]")?.addEventListener("click", () => showView("choice"));
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    // form.reset() restores attribute values, so size and price stay filled in.
    sync();
  }
</script>
