---
import { GENERAL_MESSAGE, whatsappUrl } from "../lib/whatsapp";
import WhatsAppIcon from "./WhatsAppIcon.astro";

interface Props {
  number: string;
}
const { number } = Astro.props;
---

<a
  href={whatsappUrl(number, GENERAL_MESSAGE)}
  target="_blank"
  rel="noopener"
  aria-label="Contact us on WhatsApp"
  class="wa-float fixed bottom-4 right-4 z-30 sm:bottom-6 sm:right-6"
>
  <span class="wa-tip pointer-events-none absolute right-full top-1/2 mr-2 hidden -translate-y-1/2 whitespace-nowrap bg-ink px-3 py-1.5 text-sm text-ivory lg:block" aria-hidden="true">Chat with us</span>
  <span class="flex h-14 w-14 items-center justify-center rounded-full bg-whatsapp text-white">
    <WhatsAppIcon class="h-7 w-7" />
  </span>
</a>
