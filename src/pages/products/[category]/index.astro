---
import type { GetStaticPaths } from "astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CategoryNav from "../../../components/CategoryNav.astro";
import PortableText from "../../../components/PortableText.astro";
import ProductGrid from "../../../components/ProductGrid.astro";
import SanityImage from "../../../components/SanityImage.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { categoryPath } from "../../../lib/paths";
import { getContent } from "../../../lib/sanity";
import { breadcrumbLd, categoryCrumbs, categoryDescription, categoryTitle, collectionLd } from "../../../lib/seo";
import type { Category } from "../../../lib/types";

export const getStaticPaths = (async () => {
  const { categories } = await getContent();
  return categories.map((category) => ({ params: { category: category.slug }, props: { category } }));
}) satisfies GetStaticPaths;

const { category } = Astro.props as { category: Category };
const { categories } = await getContent();
const crumbs = categoryCrumbs(category);
const description = categoryDescription(category);
---

<BaseLayout
  title={categoryTitle(category)}
  description={description}
  path={categoryPath(category)}
  image={category.image}
  jsonLd={[breadcrumbLd(crumbs), collectionLd(category.title, description, categoryPath(category), category.products)]}
>
  <div class="wrap pb-20 pt-8 lg:pb-32">
    <Breadcrumbs items={crumbs} />
    <div class="grid-12 mt-6 items-end gap-y-8">
      <div class="col-span-12 lg:col-span-7">
        <h1 class="text-title">{category.title}</h1>
        <PortableText blocks={category.description} class="mt-5 max-w-2xl" />
      </div>
      {
        category.image?.asset && (
          <div class="col-span-12 lg:col-span-4 lg:col-start-9">
            <SanityImage image={category.image} sizes="(min-width: 1024px) 32vw, 100vw" aspect={4 / 3} eager />
          </div>
        )
      }
    </div>
    <div class="mt-10"><CategoryNav categories={categories} current={category._id} /></div>
    <div class="mt-6"><ProductGrid products={category.products} /></div>
  </div>
</BaseLayout>
